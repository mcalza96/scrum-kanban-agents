#!/usr/bin/env bash
# Refuses a push whose commit does not build on its own, even if the working tree builds.
#
# In a checkout shared by several agents, «it builds» usually means «it builds with everyone's
# uncommitted changes». A commit that uses a prop whose change stayed uncommitted, or a file
# that was never `git add`ed, passes in the tree and breaks the deploy. This hook checks out each
# pushed commit in a throwaway worktree and runs the build there.
#
#   git config core.hooksPath <skill>/scripts/hooks      (or copy this file to .git/hooks/)
#   git config prepush.cmd 'npx tsc --noEmit -p .'       (the build to run; this is the default)
#
# node_modules is symlinked from the main checkout (PRE_PUSH_NODE_MODULES overrides it). A tree
# that already passed is remembered in <git-common-dir>/pre-push-verde, so a re-push is instant.
set -euo pipefail
cero=0000000000000000000000000000000000000000
common="$(git rev-parse --path-format=absolute --git-common-dir)"
modulos="${PRE_PUSH_NODE_MODULES:-$(dirname "$common")/node_modules}"
cmd="$(git config --get prepush.cmd || echo 'npx tsc --noEmit -p .')"
verdes="$common/pre-push-verde"
while read -r _ sha _ _; do
  [ "$sha" = "$cero" ] && continue
  arbol="$(git rev-parse "$sha^{tree}")"
  grep -qx "$arbol" "$verdes" 2>/dev/null && continue
  corto="$(git rev-parse --short "$sha")"
  dir="$(mktemp -d)/pre-push-$corto"
  git worktree add --detach --quiet "$dir" "$sha" </dev/null
  [ -d "$modulos" ] && ln -s "$modulos" "$dir/node_modules"
  echo "pre-push: building $corto in a clean worktree…" >&2
  if (cd "$dir" && bash -c "$cmd") </dev/null >&2; then ok=1; else ok=0; fi
  git worktree remove --force "$dir" </dev/null
  if [ "$ok" = 0 ]; then
    echo "pre-push: $corto does not build in a clean worktree; push refused." >&2
    echo "  Usually a change left uncommitted (git status) or a new file never git-added." >&2
    exit 1
  fi
  echo "$arbol" >>"$verdes"
done
